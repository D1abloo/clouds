# CloudOps Control Center — Backend API (NestJS)
# Build: docker build -f infra/docker/Dockerfile.backend-api -t cloudops-backend .

FROM node:20-bookworm-slim AS deps
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json* ./
COPY apps/backend-api/package.json ./apps/backend-api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/cloud-sdk/package.json ./packages/cloud-sdk/
RUN npm ci --workspace=@cloudops/backend-api --include-workspace-root 2>/dev/null \
  || npm install --workspace=@cloudops/backend-api --include-workspace-root

FROM node:20-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY --from=deps /app/node_modules ./node_modules
COPY package.json ./
COPY apps/backend-api ./apps/backend-api
COPY packages/shared ./packages/shared
COPY packages/cloud-sdk ./packages/cloud-sdk
WORKDIR /app/apps/backend-api
RUN npx prisma generate
RUN npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV API_PORT=3000
ENV APP_ENV=production
ENV DEMO_MODE=false
ENV PRO_MODE=true
ENV AUTO_DEMO_SEED=false
RUN apt-get update && apt-get install -y --no-install-recommends wget openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/apps/backend-api/dist ./dist
COPY --from=builder /app/apps/backend-api/package.json ./
COPY --from=builder /app/apps/backend-api/prisma ./prisma
COPY --from=builder /app/node_modules ./node_modules
COPY infra/docker/docker-entrypoint.sh /app/docker-entrypoint.sh
COPY infra/docker/ensure-users.js /app/ensure-users.js
COPY scripts/cleanup-production-demo-data.ts /app/scripts/cleanup-production-demo-data.ts
COPY scripts/cleanup-production-demo-vps.ts /app/scripts/cleanup-production-demo-vps.ts
COPY scripts/lib /app/scripts/lib
COPY apps/backend-api/scripts/provision-pro-resources.js /app/scripts/provision-pro-resources.js
COPY apps/backend-api/scripts/provision-panel-users.js /app/scripts/provision-panel-users.js
RUN chmod +x /app/docker-entrypoint.sh
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/api/v1/health || exit 1
ENTRYPOINT ["/app/docker-entrypoint.sh"]
