# CloudOps Control Center — Frontend (Angular + nginx)
# Build: docker build -f infra/docker/Dockerfile.frontend-angular -t cloudops-frontend .

FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/frontend-angular/package.json ./apps/frontend-angular/
COPY packages/ui/package.json ./packages/ui/
COPY packages/shared/package.json ./packages/shared/
RUN npm ci --workspace=@cloudops/frontend-angular --include-workspace-root 2>/dev/null \
  || npm install --workspace=@cloudops/frontend-angular --include-workspace-root
COPY apps/frontend-angular ./apps/frontend-angular
COPY packages/ui ./packages/ui
COPY packages/shared ./packages/shared
WORKDIR /app/apps/frontend-angular
RUN npm run build -- --configuration=production

FROM nginx:1.27-alpine AS runner
COPY infra/docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/frontend-angular/dist/frontend-angular/browser /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
