# CloudOps PRO — copiar a infra/.env en el servidor y rellenar secretos reales
# cp .env.production.example .env && nano .env

# URL pública del panel (IP o dominio)
PUBLIC_URL=https://spendlyx.com
CORS_ORIGIN=https://spendlyx.com,https://www.spendlyx.com
AUTH_URL=https://spendlyx.com
APP_URL=https://spendlyx.com
OAUTH_CALLBACK_URL=https://spendlyx.com/api/v1/auth/oauth/callback

# Generar: openssl rand -hex 32
JWT_SECRET=
AUTH_SECRET=
ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY=

DATABASE_URL=postgresql://cloudops:CHANGE_DB_PASSWORD@postgres:5432/cloudops
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD

APP_ENV=production
DEMO_MODE=false
PRO_MODE=true
AUTO_DEMO_SEED=false
INTEGRATIONS_LIVE=true

# OAuth login (Google/GitHub) — callback: https://spendlyx.com/api/v1/auth/oauth/callback/{provider}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth integración repositorios — callbacks separados del login:
#   https://spendlyx.com/api/v1/github/oauth/callback
#   https://spendlyx.com/api/v1/gitlab/oauth/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=

# AWS — cuenta real
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCOUNT_ID=

# GCP — JSON de cuenta de servicio (una línea o base64)
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=

# VPS Ionos
IONOS_VPS_HOST=
IONOS_VPS_PORT=22
IONOS_VPS_USER=root
IONOS_VPS_SSH_KEY=

# SMTP Ionos
SMTP_HOST=smtp.ionos.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@spendlyx.com
SMTP_PASSWORD=
SMTP_FROM="Spendlyx <info@spendlyx.com>"