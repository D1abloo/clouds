# CloudOps PRO — copiar a infra/.env en el servidor y rellenar secretos reales
# cp .env.production.example .env && nano .env

# URL pública del panel (IP o dominio)
PUBLIC_URL=http://82.223.54.195
CORS_ORIGIN=http://82.223.54.195
AUTH_URL=http://82.223.54.195
OAUTH_CALLBACK_URL=http://82.223.54.195/auth/callback

# Generar: openssl rand -hex 32
JWT_SECRET=
AUTH_SECRET=
ENCRYPTION_KEY=
VAULT_ENCRYPTION_KEY=

DATABASE_URL=postgresql://cloudops:CHANGE_DB_PASSWORD@postgres:5432/cloudops
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD

DEMO_MODE=false
PRO_MODE=true
AUTO_DEMO_SEED=false
INTEGRATIONS_LIVE=true

# OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AWS — cuenta real
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCOUNT_ID=

# GCP — JSON de cuenta de servicio (una línea o base64)
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_JSON=

# VPS Ionos
IONOS_VPS_HOST=
IONOS_VPS_PORT=22
IONOS_VPS_USER=root
IONOS_VPS_SSH_KEY=
