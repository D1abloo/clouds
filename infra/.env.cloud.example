# Copia a infra/.env.cloud (gitignored) y rellena con credenciales reales.
# Luego: bash scripts/sync-cloud-env-to-vps.sh

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCOUNT_ID=

GCP_PROJECT_ID=
# JSON de cuenta de servicio en base64 (generar con scripts/build-env-cloud.sh)
GCP_SERVICE_ACCOUNT_JSON_B64=

# IAM GCP mínimo (ver PRO_DEPLOYMENT.md § Credenciales cloud pruebas):
# - roles/compute.instanceAdmin.v1
# - roles/compute.networkUser
# - Compute Engine API habilitada en el proyecto
