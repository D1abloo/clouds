{
  "name": "cloudops-control-center",
  "version": "0.1.0",
  "private": true,
  "description": "CloudOps Control Center - Multi-cloud infrastructure management platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:backend": "npm run start:dev -w apps/backend-api",
    "dev:frontend": "bash scripts/dev-frontend.sh",
    "verify:admin-panel": "npm run build --prefix tools/admin-panel-pro-verifier-mcp && PROJECT_ROOT=\"$(pwd)\" node tools/admin-panel-pro-verifier-mcp/dist/generateReportCli.js",
    "verify:admin-panel:build": "npm run build --prefix tools/admin-panel-pro-verifier-mcp && PROJECT_ROOT=\"$(pwd)\" node tools/admin-panel-pro-verifier-mcp/dist/generateReportCli.js --with-build",
    "dev:workers": "npm run start:dev -w apps/workers",
    "prisma:generate": "npm run prisma:generate -w apps/backend-api",
    "prisma:migrate": "npm run prisma:migrate -w apps/backend-api",
    "prisma:studio": "npm run prisma:studio -w apps/backend-api",
    "prisma:seed": "npm run prisma:seed -w apps/backend-api",
    "prisma:seed:prod": "npm run prisma:seed:prod -w apps/backend-api",
    "prisma:seed:demo": "npm run prisma:seed:demo -w apps/backend-api",
    "seed:demo": "bash scripts/seed-demo.sh",
    "demo:seed": "bash scripts/demo-seed.sh",
    "demo:reset": "bash scripts/demo-reset.sh",
    "docker:up": "bash scripts/docker-up.sh",
    "github:demo:verify": "npm run github:demo:verify -w apps/backend-api",
    "github:demo:test": "npm run github:demo:test -w apps/backend-api",
    "github:demo:setup": "bash scripts/github-demo-setup.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "CloudOps Team",
  "license": "MIT"
}
