generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CloudProvider {
  AWS
  GCP
  AZURE
  CLOUDING
}

enum InstanceStatus {
  RUNNING
  STOPPED
  PENDING
  TERMINATED
  UNKNOWN
  WARNING
  ERROR
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TerraformStatus {
  PENDING
  PLANNING
  PLANNED
  APPLYING
  APPLIED
  FAILED
  DESTROYING
  DESTROYED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum CopilotAiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  OPENROUTER
}

enum CopilotScopeMode {
  PANEL_ONLY
}

enum CopilotTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  name            String?
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  company         String?
  emailVerifiedAt DateTime?  @map("email_verified_at")
  marketingConsent Boolean   @default(false) @map("marketing_consent")
  isActive        Boolean    @default(true) @map("is_active")
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  mfaSecretRef    String?    @map("mfa_secret_ref")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")
  userRoles       UserRole[]
  memberships     Membership[]
  auditLogs       AuditLog[]
  emailVerificationTokens EmailVerificationToken[]
  shortcuts       UserShortcut[]

  @@map("users")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  reason    String
  message   String
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model Organization {
  id          String                  @id @default(uuid())
  name        String
  slug        String                  @unique
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  deletedAt   DateTime?               @map("deleted_at")
  projects    Project[]
  memberships Membership[]
  aiSettings  OrganizationAiSettings?

  @@map("organizations")
}

model OrganizationAiSettings {
  id              String            @id @default(uuid())
  organizationId  String            @unique @map("organization_id")
  enabled         Boolean           @default(false)
  provider        CopilotAiProvider @default(OPENAI)
  model           String            @default("gpt-4o-mini")
  apiKeySecretRef String?           @map("api_key_secret_ref") @db.Text
  apiKeyHint      String?           @map("api_key_hint")
  scopeMode       CopilotScopeMode  @default(PANEL_ONLY) @map("scope_mode")
  allowAutonomous Boolean           @default(false) @map("allow_autonomous")
  allowLaunch     Boolean           @default(false) @map("allow_launch")
  maxTokens       Int               @default(2048) @map("max_tokens")
  temperature     Float             @default(0.3)
  systemPrompt    String?           @map("system_prompt") @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_ai_settings")
}

model CopilotAutonomousTask {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  userId         String            @map("user_id")
  prompt         String            @db.Text
  status         CopilotTaskStatus @default(PENDING)
  result         String?           @db.Text
  actions        Json              @default("[]")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("copilot_autonomous_tasks")
}

model Membership {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  user           User           @relation(fields: [userId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  action      String
  resource    String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  projectId String?  @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])

  @@unique([userId, roleId, projectId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Project {
  id             String        @id @default(uuid())
  organizationId String?       @map("organization_id")
  name           String
  slug           String        @unique
  description    String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deletedAt      DateTime?     @map("deleted_at")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userRoles      UserRole[]
  cloudAccounts  CloudAccount[]
  instances      Instance[]
  vpsServers     VpsServer[]

  @@index([organizationId])
  @@map("projects")
}

model CloudAccount {
  id            String            @id @default(uuid())
  projectId     String            @map("project_id")
  name          String
  provider      CloudProvider
  accountId     String?           @map("account_id")
  defaultRegion String?           @map("default_region")
  config        Json?
  syncStatus    String            @default("idle") @map("sync_status")
  lastSyncedAt  DateTime?         @map("last_synced_at")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")
  project     Project           @relation(fields: [projectId], references: [id])
  credentials CloudCredential[]
  regions     CloudRegion[]
  instances   Instance[]

  @@index([projectId, provider])
  @@map("cloud_accounts")
}

model CloudCredential {
  id             String       @id @default(uuid())
  cloudAccountId String       @map("cloud_account_id")
  credentialType String       @map("credential_type")
  secretRef      String       @map("secret_ref")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  cloudAccount   CloudAccount @relation(fields: [cloudAccountId], references: [id])

  @@map("cloud_credentials")
}

model CloudRegion {
  id             String       @id @default(uuid())
  cloudAccountId String       @map("cloud_account_id")
  regionId       String       @map("region_id")
  name           String
  cloudAccount   CloudAccount @relation(fields: [cloudAccountId], references: [id])

  @@unique([cloudAccountId, regionId])
  @@map("cloud_regions")
}

model Instance {
  id             String         @id @default(uuid())
  projectId      String         @map("project_id")
  cloudAccountId String?        @map("cloud_account_id")
  externalId     String         @map("external_id")
  name           String
  provider       CloudProvider
  region         String
  instanceType   String         @map("instance_type")
  status         InstanceStatus @default(UNKNOWN)
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  project        Project        @relation(fields: [projectId], references: [id])
  cloudAccount   CloudAccount?  @relation(fields: [cloudAccountId], references: [id])

  @@unique([cloudAccountId, externalId])
  @@index([projectId, provider, status])
  @@map("instances")
}

model VpsServer {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  name        String
  hostname    String
  port        Int       @default(22)
  username    String
  sshKeyRef   String    @map("ssh_key_ref")
  isActive    Boolean   @default(true) @map("is_active")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  project     Project   @relation(fields: [projectId], references: [id])
  sshSessions SshSession[]

  @@index([projectId])
  @@map("vps_servers")
}

model SshKey {
  id        String   @id @default(uuid())
  name      String
  publicKey String   @map("public_key")
  secretRef String   @map("secret_ref")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ssh_keys")
}

model SshSession {
  id          String    @id @default(uuid())
  vpsServerId String    @map("vps_server_id")
  userId      String    @map("user_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  vpsServer   VpsServer @relation(fields: [vpsServerId], references: [id])

  @@map("ssh_sessions")
}

model CommandExecution {
  id        String   @id @default(uuid())
  sessionId String?  @map("session_id")
  userId    String   @map("user_id")
  command   String
  output    String?
  exitCode  Int?     @map("exit_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("command_executions")
}

model DockerHost {
  id        String            @id @default(uuid())
  hostRef   String            @map("host_ref")
  createdAt DateTime          @default(now()) @map("created_at")
  containers DockerContainer[]

  @@map("docker_hosts")
}

model DockerContainer {
  id           String     @id @default(uuid())
  dockerHostId String     @map("docker_host_id")
  containerId  String     @map("container_id")
  name         String
  image        String
  status       String
  dockerHost   DockerHost @relation(fields: [dockerHostId], references: [id])

  @@map("docker_containers")
}

model KubernetesCluster {
  id        String                @id @default(uuid())
  name      String
  endpoint  String?
  createdAt DateTime              @default(now()) @map("created_at")
  resources KubernetesResource[]

  @@map("kubernetes_clusters")
}

model KubernetesResource {
  id        String            @id @default(uuid())
  clusterId String            @map("cluster_id")
  kind      String
  namespace String?
  name      String
  status    String?
  cluster   KubernetesCluster @relation(fields: [clusterId], references: [id])

  @@map("kubernetes_resources")
}

model JenkinsServer {
  id        String       @id @default(uuid())
  name      String
  url       String
  secretRef String       @map("secret_ref")
  createdAt DateTime     @default(now()) @map("created_at")
  jobs      JenkinsJob[]

  @@map("jenkins_servers")
}

model JenkinsJob {
  id       String         @id @default(uuid())
  serverId String         @map("server_id")
  name     String
  url      String
  server   JenkinsServer  @relation(fields: [serverId], references: [id])
  builds   JenkinsBuild[]

  @@map("jenkins_jobs")
}

model JenkinsBuild {
  id       String     @id @default(uuid())
  jobId    String     @map("job_id")
  buildNum Int        @map("build_num")
  status   String
  job      JenkinsJob @relation(fields: [jobId], references: [id])

  @@map("jenkins_builds")
}

model TerraformWorkspace {
  id        String         @id @default(uuid())
  name      String
  provider  CloudProvider
  createdAt DateTime       @default(now()) @map("created_at")
  runs      TerraformRun[]

  @@map("terraform_workspaces")
}

model TerraformRun {
  id          String            @id @default(uuid())
  workspaceId String            @map("workspace_id")
  status      TerraformStatus   @default(PENDING)
  planOutput  String?           @map("plan_output")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  workspace   TerraformWorkspace @relation(fields: [workspaceId], references: [id])
  logs        TerraformRunLog[]

  @@map("terraform_runs")
}

model TerraformRunLog {
  id        String       @id @default(uuid())
  runId     String       @map("run_id")
  level     String
  message   String
  createdAt DateTime     @default(now()) @map("created_at")
  run       TerraformRun @relation(fields: [runId], references: [id])

  @@map("terraform_run_logs")
}

model MetricSample {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  metricType String   @map("metric_type")
  value      Float
  unit       String?
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([resourceId, metricType, recordedAt])
  @@map("metric_samples")
}

model BillingAccount {
  id        String          @id @default(uuid())
  provider  CloudProvider
  accountId String          @map("account_id")
  records   BillingRecord[]

  @@map("billing_accounts")
}

model BillingRecord {
  id               String         @id @default(uuid())
  billingAccountId String         @map("billing_account_id")
  amount           Float
  currency         String         @default("USD")
  service          String?
  periodStart      DateTime       @map("period_start")
  periodEnd        DateTime       @map("period_end")
  isEstimated      Boolean        @default(false) @map("is_estimated")
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id])

  @@index([billingAccountId, periodStart])
  @@map("billing_records")
}

model AlertRule {
  id        String        @id @default(uuid())
  name      String
  condition String
  severity  AlertSeverity
  isActive  Boolean       @default(true) @map("is_active")
  alerts    Alert[]

  @@map("alert_rules")
}

model Alert {
  id          String        @id @default(uuid())
  ruleId      String        @map("rule_id")
  message     String
  severity    AlertSeverity
  isResolved  Boolean       @default(false) @map("is_resolved")
  createdAt   DateTime      @default(now()) @map("created_at")
  rule        AlertRule     @relation(fields: [ruleId], references: [id])

  @@map("alerts")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  channel   String
  title     String
  body      String
  section   String?
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, section, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, resource])
  @@map("audit_logs")
}

model InstanceTemplate {
  id        String        @id @default(uuid())
  name      String
  provider  CloudProvider
  config    Json
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("instance_templates")
}

model GithubAccount {
  id              String             @id @default(uuid())
  label           String             @default("GitHub")
  connectionName  String?            @map("connection_name")
  username        String
  tokenRef        String             @map("token_ref")
  status          String             @default("pending")
  authType        String             @default("pat") @map("auth_type")
  baseUrl         String?            @map("base_url")
  syncFrequency   String             @default("manual") @map("sync_frequency")
  lastError       String?            @map("last_error")
  avatarUrl       String?            @map("avatar_url")
  createdById     String?            @map("created_by_id")
  lastValidatedAt DateTime?          @map("last_validated_at")
  lastSyncAt      DateTime?          @map("last_sync_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  repositories    GithubRepository[]
  webhooks        GithubWebhook[]

  @@map("github_accounts")
}

model GitlabAccount {
  id              String          @id @default(uuid())
  label           String          @default("GitLab")
  connectionName  String?         @map("connection_name")
  username        String
  tokenRef        String          @map("token_ref")
  status          String          @default("pending")
  authType        String          @default("pat") @map("auth_type")
  baseUrl         String          @default("https://gitlab.com") @map("base_url")
  syncFrequency   String          @default("manual") @map("sync_frequency")
  lastError       String?         @map("last_error")
  avatarUrl       String?         @map("avatar_url")
  createdById     String?         @map("created_by_id")
  lastValidatedAt DateTime?       @map("last_validated_at")
  lastSyncAt      DateTime?       @map("last_sync_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  projects        GitlabProject[]

  @@map("gitlab_accounts")
}

model GitlabProject {
  id                String        @id @default(uuid())
  accountId         String        @map("account_id")
  name              String
  pathWithNamespace String        @map("path_with_namespace")
  description       String?
  defaultBranch     String        @default("main") @map("default_branch")
  visibility        String        @default("private")
  webUrl            String?       @map("web_url")
  lastSyncAt        DateTime?     @map("last_sync_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  account           GitlabAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, pathWithNamespace])
  @@map("gitlab_projects")
}

model GithubRepository {
  id            String              @id @default(uuid())
  accountId     String              @map("account_id")
  name          String
  fullName      String              @map("full_name")
  description   String?
  defaultBranch String              @default("main") @map("default_branch")
  language      String?
  stars         Int                 @default(0)
  visibility    String              @default("private")
  htmlUrl       String?             @map("html_url")
  lastSyncAt    DateTime?           @map("last_sync_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  account       GithubAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  branches      GithubBranch[]
  commits       GithubCommit[]
  pullRequests  GithubPullRequest[]
  deployments   GithubDeployment[]
  webhooks      GithubWebhook[]

  @@unique([accountId, fullName])
  @@map("github_repositories")
}

model GithubBranch {
  id          String           @id @default(uuid())
  repoId      String           @map("repo_id")
  name        String
  isProtected Boolean          @default(false) @map("is_protected")
  lastSha     String?          @map("last_sha")
  lastMessage String?          @map("last_message")
  repo        GithubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, name])
  @@map("github_branches")
}

model GithubCommit {
  id          String           @id @default(uuid())
  repoId      String           @map("repo_id")
  sha         String
  message     String
  author      String
  branch      String
  committedAt DateTime         @map("committed_at")
  repo        GithubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, branch])
  @@map("github_commits")
}

model GithubPullRequest {
  id         String           @id @default(uuid())
  repoId     String           @map("repo_id")
  number     Int
  title      String
  state      String
  author     String
  baseBranch String           @map("base_branch")
  headBranch String           @map("head_branch")
  createdAt  DateTime         @map("created_at")
  repo       GithubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, number])
  @@map("github_pull_requests")
}

model GithubWebhook {
  id        String            @id @default(uuid())
  accountId String?           @map("account_id")
  repoId    String?           @map("repo_id")
  event     String
  url       String
  secretRef String?           @map("secret_ref")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  account   GithubAccount?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  repo      GithubRepository? @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@map("github_webhooks")
}

model GithubDeployment {
  id          String           @id @default(uuid())
  repoId      String           @map("repo_id")
  branch      String
  targetType  String           @map("target_type")
  targetId    String           @map("target_id")
  targetName  String           @map("target_name")
  status      String           @default("running")
  logs        String?          @db.Text
  createdById String?          @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")
  finishedAt  DateTime?        @map("finished_at")
  repo        GithubRepository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([repoId, createdAt])
  @@map("github_deployments")
}

model IntegrationConfig {
  id         String                @id
  label      String
  category   String
  enabled    Boolean               @default(false)
  status     String                @default("disconnected")
  config     Json                  @default("{}")
  events     Json                  @default("[]")
  lastSync   DateTime?             @map("last_sync")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  deliveries IntegrationDelivery[]

  @@map("integration_configs")
}

model IntegrationDelivery {
  id            String            @id @default(uuid())
  integrationId String            @map("integration_id")
  eventType     String            @map("event_type")
  title         String
  body          String            @db.Text
  status        String
  httpStatus    Int?              @map("http_status")
  latencyMs     Int?              @map("latency_ms")
  error         String?
  payload       Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@map("integration_deliveries")
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String
  providerAccountId String   @map("provider_account_id")
  accessTokenRef    String?  @map("access_token_ref")
  refreshTokenRef   String?  @map("refresh_token_ref")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, expiresAt])
  @@map("sessions")
}

model ApiToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  prefix     String
  tokenHash  String    @map("token_hash")
  scopes     Json      @default("[]")
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  revokedAt  DateTime? @map("revoked_at")

  @@index([userId])
  @@map("api_tokens")
}

model Runbook {
  id          String   @id @default(uuid())
  name        String
  description String?
  steps       Json     @default("[]")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  executions  RunbookExecution[]

  @@map("runbooks")
}

model RunbookExecution {
  id         String   @id @default(uuid())
  runbookId  String   @map("runbook_id")
  status     String   @default("pending")
  startedBy  String?  @map("started_by")
  startedAt  DateTime @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  runbook    Runbook  @relation(fields: [runbookId], references: [id], onDelete: Cascade)

  @@index([runbookId, startedAt])
  @@map("runbook_executions")
}

model Schedule {
  id        String   @id @default(uuid())
  name      String
  cron      String
  target    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schedules")
}

model Approval {
  id          String   @id @default(uuid())
  title       String
  status      String   @default("pending")
  requestedBy String?  @map("requested_by")
  resource    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("approvals")
}

model Secret {
  id        String   @id @default(uuid())
  name      String
  secretRef String   @map("secret_ref")
  scope     String   @default("platform")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("secrets")
}

model CompliancePolicy {
  id        String   @id @default(uuid())
  name      String
  framework String
  status    String   @default("active")
  rules     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("compliance_policies")
}

model ChangeRequest {
  id          String   @id @default(uuid())
  title       String
  status      String   @default("draft")
  priority    String   @default("medium")
  requestedBy String?  @map("requested_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("change_requests")
}

model Report {
  id        String   @id @default(uuid())
  name      String
  type      String
  status    String   @default("ready")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reports")
}

model Incident {
  id          String   @id @default(uuid())
  title       String
  severity    String
  status      String   @default("open")
  assignedTo  String?  @map("assigned_to")
  createdAt   DateTime @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@index([status, severity])
  @@map("incidents")
}

model Backup {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  resourceType String @map("resource_type")
  status     String   @default("completed")
  sizeBytes  BigInt?  @map("size_bytes")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@map("backups")
}

model StorageVolume {
  id        String   @id @default(uuid())
  name      String
  provider  CloudProvider?
  sizeGb    Int      @map("size_gb")
  status    String   @default("available")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("storage_volumes")
}

model NetworkResource {
  id        String   @id @default(uuid())
  name      String
  cidr      String?
  provider  CloudProvider?
  region    String?
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("network_resources")
}

model CostOptimizationRecommendation {
  id           String   @id @default(uuid())
  resourceId   String   @map("resource_id")
  title        String
  savingsUsd   Float    @map("savings_usd")
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("cost_optimization_recommendations")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AssistantThread {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  title     String?
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  messages  AssistantMessage[]

  @@index([userId])
  @@map("assistant_threads")
}

model AssistantMessage {
  id        String          @id @default(uuid())
  threadId  String          @map("thread_id")
  role      String
  content   String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at")
  thread    AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("assistant_messages")
}

model AdminWebhook {
  id        String   @id @default(uuid())
  name      String
  url       String
  events    Json     @default("[]")
  secretRef String?  @map("secret_ref")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_webhooks")
}

model UserShortcut {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  organizationId String?   @map("organization_id")
  route          String
  label          String
  section        String?
  icon           String?
  position       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route])
  @@index([userId, position])
  @@map("user_shortcuts")
}
