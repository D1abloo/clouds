generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CloudProvider {
  AWS
  GCP
  AZURE
}

enum InstanceStatus {
  RUNNING
  STOPPED
  PENDING
  TERMINATED
  UNKNOWN
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TerraformStatus {
  PENDING
  PLANNING
  PLANNED
  APPLYING
  APPLIED
  FAILED
  DESTROYING
  DESTROYED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String?
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")
  userRoles    UserRole[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  action      String
  resource    String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@unique([action, resource])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  projectId String?  @map("project_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id])

  @@unique([userId, roleId, projectId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model Project {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  description   String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")
  userRoles     UserRole[]
  cloudAccounts CloudAccount[]
  instances     Instance[]
  vpsServers    VpsServer[]

  @@map("projects")
}

model CloudAccount {
  id          String            @id @default(uuid())
  projectId   String            @map("project_id")
  name        String
  provider    CloudProvider
  accountId   String?           @map("account_id")
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")
  project     Project           @relation(fields: [projectId], references: [id])
  credentials CloudCredential[]
  regions     CloudRegion[]
  instances   Instance[]

  @@index([projectId, provider])
  @@map("cloud_accounts")
}

model CloudCredential {
  id             String       @id @default(uuid())
  cloudAccountId String       @map("cloud_account_id")
  credentialType String       @map("credential_type")
  secretRef      String       @map("secret_ref")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  cloudAccount   CloudAccount @relation(fields: [cloudAccountId], references: [id])

  @@map("cloud_credentials")
}

model CloudRegion {
  id             String       @id @default(uuid())
  cloudAccountId String       @map("cloud_account_id")
  regionId       String       @map("region_id")
  name           String
  cloudAccount   CloudAccount @relation(fields: [cloudAccountId], references: [id])

  @@unique([cloudAccountId, regionId])
  @@map("cloud_regions")
}

model Instance {
  id             String         @id @default(uuid())
  projectId      String         @map("project_id")
  cloudAccountId String?        @map("cloud_account_id")
  externalId     String         @map("external_id")
  name           String
  provider       CloudProvider
  region         String
  instanceType   String         @map("instance_type")
  status         InstanceStatus @default(UNKNOWN)
  metadata       Json?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  project        Project        @relation(fields: [projectId], references: [id])
  cloudAccount   CloudAccount?  @relation(fields: [cloudAccountId], references: [id])

  @@unique([cloudAccountId, externalId])
  @@index([projectId, provider, status])
  @@map("instances")
}

model VpsServer {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  name        String
  hostname    String
  port        Int       @default(22)
  username    String
  sshKeyRef   String    @map("ssh_key_ref")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  project     Project   @relation(fields: [projectId], references: [id])
  sshSessions SshSession[]

  @@index([projectId])
  @@map("vps_servers")
}

model SshKey {
  id        String   @id @default(uuid())
  name      String
  publicKey String   @map("public_key")
  secretRef String   @map("secret_ref")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ssh_keys")
}

model SshSession {
  id          String    @id @default(uuid())
  vpsServerId String    @map("vps_server_id")
  userId      String    @map("user_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  vpsServer   VpsServer @relation(fields: [vpsServerId], references: [id])

  @@map("ssh_sessions")
}

model CommandExecution {
  id        String   @id @default(uuid())
  sessionId String?  @map("session_id")
  userId    String   @map("user_id")
  command   String
  output    String?
  exitCode  Int?     @map("exit_code")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("command_executions")
}

model DockerHost {
  id        String            @id @default(uuid())
  hostRef   String            @map("host_ref")
  createdAt DateTime          @default(now()) @map("created_at")
  containers DockerContainer[]

  @@map("docker_hosts")
}

model DockerContainer {
  id           String     @id @default(uuid())
  dockerHostId String     @map("docker_host_id")
  containerId  String     @map("container_id")
  name         String
  image        String
  status       String
  dockerHost   DockerHost @relation(fields: [dockerHostId], references: [id])

  @@map("docker_containers")
}

model KubernetesCluster {
  id        String                @id @default(uuid())
  name      String
  endpoint  String?
  createdAt DateTime              @default(now()) @map("created_at")
  resources KubernetesResource[]

  @@map("kubernetes_clusters")
}

model KubernetesResource {
  id        String            @id @default(uuid())
  clusterId String            @map("cluster_id")
  kind      String
  namespace String?
  name      String
  status    String?
  cluster   KubernetesCluster @relation(fields: [clusterId], references: [id])

  @@map("kubernetes_resources")
}

model JenkinsServer {
  id        String       @id @default(uuid())
  name      String
  url       String
  secretRef String       @map("secret_ref")
  createdAt DateTime     @default(now()) @map("created_at")
  jobs      JenkinsJob[]

  @@map("jenkins_servers")
}

model JenkinsJob {
  id       String         @id @default(uuid())
  serverId String         @map("server_id")
  name     String
  url      String
  server   JenkinsServer  @relation(fields: [serverId], references: [id])
  builds   JenkinsBuild[]

  @@map("jenkins_jobs")
}

model JenkinsBuild {
  id       String     @id @default(uuid())
  jobId    String     @map("job_id")
  buildNum Int        @map("build_num")
  status   String
  job      JenkinsJob @relation(fields: [jobId], references: [id])

  @@map("jenkins_builds")
}

model TerraformWorkspace {
  id        String         @id @default(uuid())
  name      String
  provider  CloudProvider
  createdAt DateTime       @default(now()) @map("created_at")
  runs      TerraformRun[]

  @@map("terraform_workspaces")
}

model TerraformRun {
  id          String            @id @default(uuid())
  workspaceId String            @map("workspace_id")
  status      TerraformStatus   @default(PENDING)
  planOutput  String?           @map("plan_output")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  workspace   TerraformWorkspace @relation(fields: [workspaceId], references: [id])
  logs        TerraformRunLog[]

  @@map("terraform_runs")
}

model TerraformRunLog {
  id        String       @id @default(uuid())
  runId     String       @map("run_id")
  level     String
  message   String
  createdAt DateTime     @default(now()) @map("created_at")
  run       TerraformRun @relation(fields: [runId], references: [id])

  @@map("terraform_run_logs")
}

model MetricSample {
  id         String   @id @default(uuid())
  resourceId String   @map("resource_id")
  metricType String   @map("metric_type")
  value      Float
  unit       String?
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([resourceId, metricType, recordedAt])
  @@map("metric_samples")
}

model BillingAccount {
  id        String          @id @default(uuid())
  provider  CloudProvider
  accountId String          @map("account_id")
  records   BillingRecord[]

  @@map("billing_accounts")
}

model BillingRecord {
  id               String         @id @default(uuid())
  billingAccountId String         @map("billing_account_id")
  amount           Float
  currency         String         @default("USD")
  service          String?
  periodStart      DateTime       @map("period_start")
  periodEnd        DateTime       @map("period_end")
  isEstimated      Boolean        @default(false) @map("is_estimated")
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id])

  @@index([billingAccountId, periodStart])
  @@map("billing_records")
}

model AlertRule {
  id        String        @id @default(uuid())
  name      String
  condition String
  severity  AlertSeverity
  isActive  Boolean       @default(true) @map("is_active")
  alerts    Alert[]

  @@map("alert_rules")
}

model Alert {
  id          String        @id @default(uuid())
  ruleId      String        @map("rule_id")
  message     String
  severity    AlertSeverity
  isResolved  Boolean       @default(false) @map("is_resolved")
  createdAt   DateTime      @default(now()) @map("created_at")
  rule        AlertRule     @relation(fields: [ruleId], references: [id])

  @@map("alerts")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  channel   String
  title     String
  body      String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, resource])
  @@map("audit_logs")
}

model InstanceTemplate {
  id        String        @id @default(uuid())
  name      String
  provider  CloudProvider
  config    Json
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("instance_templates")
}
