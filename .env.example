NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://cloudops:cloudops_dev_password@localhost:5432/cloudops
REDIS_URL=redis://localhost:6379
CLOUD_CATALOG_CACHE_TTL_SECONDS=600
JWT_SECRET=change_me_in_production_use_long_random_string
JWT_EXPIRES_IN=1d
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_ENCRYPTION_KEY=change_me_cloudops_vault_encryption_key_32chars
JENKINS_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:4200
LOG_LEVEL=debug
DEMO_MODE=false
PRO_MODE=true
APP_ENV=production
# Auth PRO
AUTH_SECRET=change_me_in_production_use_long_random_string
AUTH_URL=http://localhost:4200
APP_URL=https://spendlyx.com
# OAuth PRO (Google / GitHub login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:4200/api/v1/auth/oauth/callback
# Integraciones (Slack, PagerDuty, Jira) — en PRO: DEMO_MODE=false e INTEGRATIONS_LIVE=true
INTEGRATIONS_LIVE=false
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# SMTP Ionos (Spendlyx transactional email)
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Spendlyx <info@spendlyx.com>"
CONTACT_INBOX=info@spendlyx.com
